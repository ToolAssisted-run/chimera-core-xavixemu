{
  "coreName": "XaviXEmu",
  "systemId": "XAVIX",
  "systemNames": {
    "XAVIX": "XaviX"
  },
  "author": "Billy Jr. and contributors",
  "url": "https://github.com/BillyJr0127/XaviXEmu",
  "runsOn": [ "windows-x86_64", "linux-x86_64", "macos-x86_64", "windows-aarch64", "linux-aarch64", "macos-aarch64" ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    4,
    4,
    4,
    4,
    40
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The machine itself (372576 bytes) is in the program's own data. The mmap heap holds the ROM (up to 8 MiB) and, while the game is being read, the ZIP of it (up to 16 MiB) and its unpacked image.",
  "video": {
    "_comment": "The picture is always 256 by 224.",
    "width": 256,
    "height": 224,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "_vsync_note": "XaviXEmu runs 60 frames a second exactly: a frame is 21477272 / 60 clock ticks, with the remainder carried to the next.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "48000 Hz stereo, 800 sample pairs a frame, which the core reports each frame.",
    "rate": 48000,
    "samplesPerFrame": 1024,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".zip": "XAVIX",
    ".bin": "XAVIX"
  },
  "input": {
    "name": "XaviX",
    "_comment": "A pad of four directions and two buttons, and a Pause. The order is the wire format. The machine reads each as one bit of a register; two opposite directions cancel.",
    "buttons": [
      "Up",
      "Down",
      "Left",
      "Right",
      "OK",
      "Back",
      "Pause"
    ],
    "players": [
      [ "Up", "Down", "Left", "Right", "OK", "Back", "Pause" ]
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "OK": "O",
      "Back": "B",
      "Pause": "P"
    }
  }
}
